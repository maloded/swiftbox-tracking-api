DATABASE_URL=postgresql://user:password@db:5432/swiftbox
PORT=3000

# Required to protect /tracking routes. Unset = guard is skipped (local dev only).
API_KEY=

# Required for OTP code hashing (HMAC-SHA256). Any long random string.
OTP_SECRET=

# SMTP for sending the OTP email (nodemailer).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional overrides for testing — leave unset to use the defaults
# (60s cooldown, 10min code TTL, 15min verifyToken TTL).
OTP_COOLDOWN_MS=
OTP_TTL_MS=
OTP_VERIFY_TTL_MS=
